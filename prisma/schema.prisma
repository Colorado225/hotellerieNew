  OWNER
  GENERAL_MANAGER
  FRONT_DESK_MANAGER
  RECEPTIONIST
  CASHIER
  HOUSEKEEPING_SUPERVISOR
  HOUSEKEEPER
  MAINTENANCE
  ACCOUNTANT
  AUDITOR
}

enum RoomStatus {
