// LagoonKey — PMS hôtelier
// Schéma de données V1 (PROMPTMVP.md sections 8 à 42).
//
// Conventions non négociables (section 6) :
//   - Les montants sont des BigInt. Le XOF n'a pas de sous-unité, donc
//     1 = 1 FCFA. Jamais de Float.
//   - Les horodatages techniques sont des timestamptz (UTC). La date
//     d'exploitation hôtelière est un champ business_date explicite, jamais
//     dérivée d'un timestamp.
//   - property_id est dénormalisé sur les entités opérationnelles pour
//     permettre les index composites exigés en section 103. L'intégrité
//     multi-tenant sera appliquée en base (RLS) en phase 2.
//
// Soft delete (section 104) : uniquement sur les données maîtres, via
// deleted_at. Aucune transaction financière n'est jamais soft-deleted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums — section 92. Toute nomenclature de statut vit ici, jamais en libellé
// libre dans le code applicatif.
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

enum HotelClassification {
  NO_STAR
  ONE_STAR
  TWO_STAR
  THREE_STAR_PLUS
}

enum UserStatus {
