# --- Database -----------------------------------------------------------
# Runtime connection string. Use the POOLED endpoint on serverless (Vercel)
# to survive connection exhaustion. PgBouncer runs in transaction mode.
DATABASE_URL="postgresql://lagoonkey:lagoonkey@localhost:5432/lagoonkey?schema=public"

# Direct (unpooled) endpoint. Migrations and scripts MUST use this one:
# Prisma migrate relies on protocol-level prepared statements, which are
# incompatible with PgBouncer transaction mode.
DIRECT_URL="postgresql://lagoonkey:lagoonkey@localhost:5432/lagoonkey?schema=public&connection_limit=5"

# --- Cache / Queue ------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
# REQUIRED. Without a non-empty value Auth.js refuses every authentication
# request with `MissingSecret` and the login form silently fails. Generate one
# with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Maximum session lifetime in seconds (12 hours).
AUTH_SESSION_MAX_AGE="43200"

# --- Object storage (S3 compatible) -------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="lagoonkey"
S3_ACCESS_KEY="lagoonkey"
S3_SECRET_KEY="lagoonkey_secret"
S3_FORCE_PATH_STYLE="true"

# --- Email --------------------------------------------------------------
EMAIL_PROVIDER="mailpit"
EMAIL_FROM="no-reply@lagoonkey.local"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""

# --- FNE (normalisation fiscale ivoirienne) -----------------------------
# Leave FNE_MODE="mock" for development and tests. Never commit real
# credentials. Endpoint specifics must come from the official DGI FNE
# documentation in force at deployment time.
FNE_MODE="mock"
FNE_BASE_URL=""
FNE_API_KEY=""
FNE_API_SECRET=""
FNE_TIMEOUT_MS="30000"

# --- Authentication (Auth.js) --------------------------------------------
# Credentials remains the primary method. Google is optional: when these two
# values are empty the provider is not registered and the interface hides the
# button, so local development works without any Google setup.
# Create the credentials at https://console.cloud.google.com/apis/credentials
# and register the redirect URI <APP_URL>/api/auth/callback/google.
# Google only proves control of an email address: it never creates an account.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Observability ------------------------------------------------------
LOG_LEVEL="info"
# Public base URL, used in PDF headers and notification links.
APP_URL="http://localhost:3000"

# --- Deployment safety rails --------------------------------------------
# "development" | "staging" | "production"
APP_ENV="development"
# Seeds are never applied automatically when NODE_ENV=production.
ALLOW_DEMO_SEED="true"